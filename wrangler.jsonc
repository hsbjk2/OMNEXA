{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omnexa",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omnexa",
      "database_id": "a055e512-5390-420d-8996-cd22d58f00ea"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "omnexa"
    }
  ]
}
