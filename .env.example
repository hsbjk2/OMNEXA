# Copy this file to .env and fill in real values before running OMNEXA.

# --- Core ---
DATABASE_URL="file:./dev.db"
# Adapter selection: auto (default), d1, or sqlite. Auto uses the D1 binding
# when present and falls back to the local SQLite file otherwise.
OMNEXA_DATABASE="auto"
APP_URL="http://localhost:3000"

# --- Bootstrap admin (used only by prisma/seed.ts; never exposed to the browser) ---
ADMIN_EMAIL="admin@your-domain.example"
ADMIN_PASSWORD="use-a-long-unique-password"
ADMIN_NAME="OMNEXA Admin"

# --- Store operations ---
SHIPPING_FLAT_RATE="79"
FREE_SHIPPING_THRESHOLD="1499"
STORE_CONTACT_EMAIL="omnexaenterprise@gmail.com"
STORE_WHATSAPP="+91 80599 12655"
WHATSAPP_CHANNEL_URL="https://whatsapp.com/channel/0029VbD0oy79sBI5P6MSla0d"
WHATSAPP_CATALOGUE_URL="https://wa.me/c/918059912655"

# --- Email (Resend). Without this, verification and reset links are logged in development. ---
RESEND_API_KEY=""
EMAIL_FROM="OMNEXA <omnexaenterprise@gmail.com>"

# --- Optional Google sign-in ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Optional marketplace defaults (admin settings override these) ---
AMAZON_STORE_URL=""
FLIPKART_STORE_URL="https://www.flipkart.com/sellers?pid=ERGHZTUJKZFZVXEF&utm"
