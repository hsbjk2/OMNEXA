# Copy this file to .env and fill in real values before running OMNEXA.

# --- Core ---
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"

# --- Bootstrap admin (used only by prisma/seed.ts; never exposed to the browser) ---
ADMIN_EMAIL="admin@your-domain.example"
ADMIN_PASSWORD="use-a-long-unique-password"
ADMIN_NAME="OMNEXA Admin"

# --- Store operations ---
SHIPPING_FLAT_RATE="79"
FREE_SHIPPING_THRESHOLD="1499"
STORE_CONTACT_EMAIL="care@your-domain.example"

# --- Email (Resend). Without this, verification and reset links are logged in development. ---
RESEND_API_KEY=""
EMAIL_FROM="OMNEXA <care@your-domain.example>"

# --- Optional Google sign-in ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Optional marketplace defaults (admin settings override these) ---
AMAZON_STORE_URL=""
FLIPKART_STORE_URL=""
